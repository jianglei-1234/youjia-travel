/* pages/album/album.wxss */
.album-page {
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 40rpx;
}

/* 统计卡片 */
.album-stats {
  display: flex;
  margin: 20rpx 24rpx;
  gap: 16rpx;
}
.album-stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.alb-stat-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}
.alb-stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #07c160;
}
.alb-stat-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

/* 空状态 */
.empty-album {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}
.empty-title {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
}
.empty-sub {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
}

/* 日期分组 */
.date-group {
  margin: 0 24rpx;
}
.date-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 24rpx 0 10rpx;
}
.date-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.date-count {
  font-size: 22rpx;
  color: #999;
}

/* 相册卡片 */
.album-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}
.card-head {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
}
.color-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}
.card-location {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.card-status {
  font-size: 20rpx;
  color: #07c160;
  background: #e8f5e9;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

/* 宫格照片 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
}
.grid-photo {
  width: calc(33.33% - 2rpx);
  height: 200rpx;
  margin: 1rpx;
}
.grid-photo.first {
  width: 100%;
  height: 320rpx;
}

/* 列表模式 */
.photo-list {
  padding: 0 20rpx;
}
.list-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.list-row:last-child {
  border-bottom: none;
}
.list-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.list-info {
  flex: 1;
  margin-left: 16rpx;
}
.list-name {
  font-size: 26rpx;
  color: #333;
  display: block;
}
.list-loc {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}
.list-del {
  font-size: 32rpx;
  padding: 10rpx;
  opacity: 0.6;
}

/* 备注 */
.card-note {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #666;
  background: #fafafa;
  line-height: 1.6;
}
.note-label {
  color: #07c160;
}
.note-content {
  word-break: break-all;
}

/* 底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
.footer-hint {
  font-size: 20rpx;
  color: #bbb;
}
.footer-view {
  font-size: 22rpx;
  color: #07c160;
  font-weight: 500;
}


