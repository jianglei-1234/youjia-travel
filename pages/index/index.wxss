/**
 * 游佳记 · 主页样式 v2（精致 + 动效版）
 */

/* ══ 顶部栏 ══ */
.top-bar {
  background: linear-gradient(135deg, #07c160 0%, #00b89a 100%);
  padding: 28rpx 32rpx 20rpx;
}
.top-title-row {
  display: flex; align-items: center; justify-content: space-between;
}
.top-title {
  font-size: 38rpx; font-weight: 800; color: #fff; letter-spacing: 1rpx;
}
.top-actions { display: flex; gap: 16rpx; }
.top-btn {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: rgba(255,255,255,.2); display: flex; align-items: center;
  justify-content: center; font-size: 30rpx;
  transition: transform .15s, background .15s;
}
.top-btn:active { transform: scale(.88); background: rgba(255,255,255,.35); }
.danger-btn { background: rgba(250,81,81,.35); }

/* 搜索框 */
.search-input-row {
  display: flex; align-items: center; gap: 16rpx;
  animation: slideDown .25s cubic-bezier(.4,0,.2,1);
}
@keyframes slideDown {
  from { opacity:0; transform:translateY(-10rpx); }
  to   { opacity:1; transform:translateY(0); }
}
.search-input {
  flex: 1; height: 72rpx; background: rgba(255,255,255,.95);
  border-radius: 36rpx; padding: 0 28rpx; font-size: 28rpx; color: #191919;
}
.search-cancel-btn {
  font-size: 28rpx; color: rgba(255,255,255,.9); font-weight: 500; flex-shrink: 0;
}

/* ══ 仪表盘 ══ */
.dashboard {
  background: linear-gradient(135deg, #07c160 0%, #00b89a 100%);
  padding: 0 32rpx 36rpx;
}
.stats-grid { display: flex; gap: 14rpx; margin-bottom: 24rpx; }
.stat-card {
  flex: 1; background: rgba(255,255,255,.18); border-radius: 22rpx;
  padding: 22rpx 10rpx 18rpx; text-align: center;
  border: 2rpx solid rgba(255,255,255,.22);
  transition: transform .15s, background .15s;
}
.stat-card:active { transform: scale(.95); background: rgba(255,255,255,.28); }
.stat-num { display:block; font-size:44rpx; font-weight:800; color:#fff; line-height:1.1; }
.stat-label { display:block; font-size:20rpx; color:rgba(255,255,255,.85); margin-top:6rpx; }

.progress-wrap { display: flex; align-items: center; gap: 14rpx; }
.progress-track { flex:1; height:14rpx; background:rgba(255,255,255,.3); border-radius:100rpx; overflow:hidden; }
.progress-bar {
  height:100%; background:linear-gradient(90deg, rgba(255,255,255,.85), #fff);
  border-radius:100rpx; transition:width .8s cubic-bezier(.4,0,.2,1);
}
.progress-pct { font-size:22rpx; color:rgba(255,255,255,.9); font-weight:600; min-width:60rpx; text-align:right; }

/* ══ 筛选 Tab ══ */
.filter-nav {
  display: flex; background: #fff;
  border-bottom: 2rpx solid #ebebeb; padding: 0 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}
.filter-btn {
  flex: 1; text-align: center; padding: 20rpx 0 18rpx;
  font-size: 26rpx; font-weight: 500; color: #9a9a9a;
  position: relative; transition: color .2s;
  border-radius: 12rpx 12rpx 0 0;
}
.filter-btn.active { color: #07c160; font-weight: 700; }
.filter-btn.active::after {
  content:''; position:absolute; bottom:0; left:50%; transform:translateX(-50%);
  width:40rpx; height:6rpx; background:#07c160; border-radius:100rpx;
  transition: width .2s;
}
.filter-btn-hover { background: #f0fdf7; }

/* ══ 列表 ══ */
.trip-list { height: calc(100vh - 480rpx); padding: 20rpx 28rpx; box-sizing: border-box; }

/* ══ 空状态 ══ */
.empty-state { display:flex; flex-direction:column; align-items:center; padding:120rpx 60rpx 80rpx; }
.empty-emoji { font-size:100rpx; margin-bottom:28rpx; animation: float 3s ease-in-out infinite; }
@keyframes float {
  0%,100% { transform: translateY(0); }
  50%      { transform: translateY(-12rpx); }
}
.empty-title { font-size:30rpx; font-weight:600; color:#576b95; margin-bottom:12rpx; }
.empty-sub { font-size:24rpx; color:#9a9a9a; line-height:1.6; text-align:center; }

/* ══ 日期分组 ══ */
.date-group { margin-bottom:14rpx; }
.date-header { display:flex; align-items:center; gap:12rpx; padding:16rpx 8rpx 10rpx; }
.date-main { font-size:26rpx; font-weight:700; color:#576b95; }
.date-weekday { font-size:22rpx; color:#9a9a9a; }
.date-today-badge {
  font-size:20rpx; font-weight:600; background:#07c160; color:#fff;
  padding:4rpx 14rpx; border-radius:100rpx;
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(7,193,96,.4); }
  50%      { box-shadow: 0 0 0 8rpx rgba(7,193,96,0); }
}

/* ══ 卡片 ══ */
.card-wrapper { position:relative; margin-bottom:18rpx; border-radius:22rpx; overflow:hidden; }
.card-swipe-bg {
  position:absolute; inset:0; background:linear-gradient(135deg,#ff6b6b,#fa5151);
  display:flex; align-items:center; justify-content:flex-end;
  padding-right:40rpx; border-radius:22rpx;
}
.card-swipe-bg text { color:#fff; font-size:26rpx; font-weight:600; }

.trip-card {
  background: #fff; border-radius: 22rpx; padding: 22rpx 20rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.07);
  position: relative; z-index: 1;
  border-left: 8rpx solid #07c160;
  transition: transform .25s cubic-bezier(.4,0,.2,1), box-shadow .25s;
}
.card-wrapper.swiping .trip-card { transition: none; }
.trip-card.is-checked { opacity: .72; }
.trip-card.is-important {
  box-shadow: 0 4rpx 24rpx rgba(255,153,0,.18);
}

/* 重要角标 */
.important-badge {
  position: absolute; top: -2rpx; right: 18rpx;
  font-size: 28rpx; z-index: 2;
  animation: starPop .3s cubic-bezier(.34,1.56,.64,1);
}
@keyframes starPop {
  from { transform: scale(0) rotate(-30deg); }
  to   { transform: scale(1) rotate(0); }
}

.card-body { display:flex; align-items:flex-start; gap:14rpx; }

/* 打卡框 */
.card-check {
  flex-shrink: 0; width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 3rpx solid #d9d9d9; background: #fff;
  display: flex; align-items: center; justify-content: center; margin-top: 4rpx;
  transition: background .2s, border-color .2s, transform .15s;
}
.card-check.checked { background: #07c160; border-color: #07c160; }
.card-check:active { transform: scale(.85); }
.check-icon { width: 22rpx; height: 16rpx; }

.card-content { flex:1; min-width:0; }
.card-location-row { display:flex; align-items:center; margin-bottom:4rpx; }
.card-location-text { font-size:30rpx; font-weight:700; color:#191919; }
.line-through { text-decoration:line-through; color:#9a9a9a; font-weight:500; }
.card-time { font-size:22rpx; color:#9a9a9a; margin-bottom:4rpx; display:block; }
.card-notes {
  font-size:22rpx; color:#576b95; margin-top:6rpx;
  word-break:break-all; line-height:1.6; display:block;
  white-space: pre-wrap;
}
.card-gps-tag {
  display:inline-block; font-size:20rpx; color:#10aeff;
  background:#e8f5ff; padding:3rpx 12rpx; border-radius:100rpx; margin-top:6rpx;
}

/* 右侧操作区 */
.card-right { flex-shrink:0; display:flex; flex-direction:column; align-items:flex-end; gap:10rpx; }
.card-right-actions { display:flex; gap:8rpx; }
.btn-action {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #f6f6f6; display: flex; align-items: center;
  justify-content: center; font-size: 22rpx;
  transition: background .15s, transform .15s;
}
.btn-action:active { transform: scale(.82); }
.btn-star:active { background: #fff7e6; }
.btn-star.starred { background: #fff7e6; }
.btn-edit:active { background: #e8f2ff; }
.btn-gps:active { background: #edfbf4; }
.btn-delete:active { background: #ffe8e8; color: #fa5151; }

/* 照片网格 */
.card-photos { display:grid; grid-template-columns:repeat(2, 76rpx); gap:7rpx; }
.photo-thumb {
  width:76rpx; height:76rpx; border-radius:10rpx;
  border:2rpx solid rgba(0,0,0,.06);
  transition: transform .15s;
}
.photo-thumb:active { transform: scale(.92); }
.photo-more-badge {
  width:76rpx; height:76rpx; border-radius:10rpx;
  background:rgba(0,0,0,.52); color:#fff;
  display:flex; align-items:center; justify-content:center;
  font-size:22rpx; font-weight:700;
}

.card-tags { display:flex; flex-wrap:wrap; gap:8rpx; margin-top:16rpx; margin-left:56rpx; }
.tag { padding:5rpx 14rpx; border-radius:100rpx; font-size:20rpx; font-weight:500; }
.tag-countdown { background:#fff7e6; color:#ff9900; }
.tag-today     { background:#edfbf4; color:#07c160; }
.tag-expired   { background:#f3f3f3; color:#9a9a9a; }

/* ══ FAB ══ */
.fab {
  position:fixed; bottom:60rpx; right:60rpx;
  width:104rpx; height:104rpx; border-radius:50%;
  background:linear-gradient(135deg,#07c160,#00b89a);
  box-shadow:0 12rpx 40rpx rgba(7,193,96,.45);
  display:flex; align-items:center; justify-content:center; z-index:100;
  transition: transform .2s cubic-bezier(.34,1.56,.64,1), box-shadow .2s;
}
.fab-hover { transform:scale(.9); box-shadow:0 6rpx 20rpx rgba(7,193,96,.3); }
.fab-icon { font-size:52rpx; color:#fff; font-weight:300; line-height:1; margin-top:-4rpx; }

/* ══ Overlay & Sheet ══ */
.overlay {
  position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:200;
  opacity:0; pointer-events:none; transition:opacity .3s;
}
.overlay.open { opacity:1; pointer-events:all; }
.sheet {
  position:absolute; bottom:0; left:0; right:0;
  background:#fff; border-radius:40rpx 40rpx 0 0;
  padding:0 36rpx 120rpx;
  max-height:88vh; overflow-y:auto;
  transform:translateY(100%); transition:transform .38s cubic-bezier(.4,0,.2,1);
}
.overlay.open .sheet { transform:translateY(0); }
.sheet-handle {
  width:72rpx; height:8rpx; background:#e5e5e5; border-radius:100rpx;
  margin:22rpx auto 28rpx;
}
.sheet-title { font-size:36rpx; font-weight:800; text-align:center; margin-bottom:32rpx; display:block; color:#191919; }

/* ══ 颜色选择 ══ */
.color-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:24rpx; }
.color-picker { display:flex; gap:16rpx; }
.color-dot {
  width:44rpx; height:44rpx; border-radius:50%;
  border:4rpx solid transparent; box-sizing:border-box;
  transition:transform .2s, border-color .2s;
}
.color-dot.selected { border-color:#191919; transform:scale(1.2); }

/* ══ 重要开关 ══ */
.important-toggle-row {
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:24rpx; padding:16rpx 20rpx;
  background:#fffbf0; border-radius:16rpx; border:2rpx solid #ffe8a0;
}
.toggle-switch {
  width:88rpx; height:48rpx; border-radius:100rpx;
  background:#d9d9d9; position:relative; transition:background .25s;
}
.toggle-switch.on { background:#07c160; }
.toggle-thumb {
  position:absolute; top:6rpx; left:6rpx;
  width:36rpx; height:36rpx; border-radius:50%; background:#fff;
  box-shadow:0 2rpx 8rpx rgba(0,0,0,.2);
  transition:left .25s cubic-bezier(.4,0,.2,1);
}
.toggle-switch.on .toggle-thumb { left:46rpx; }

/* ══ 表单 ══ */
.form-field { width:100%; display:flex; flex-direction:column; margin-bottom:24rpx; overflow:visible; }
.form-field .field-label { display:block; margin-bottom:10rpx; }
.form-row { display:flex; gap:20rpx; }
.form-row .form-field { flex:1; }
.field-label { font-size:24rpx; font-weight:600; color:#576b95; }
.field-input {
  width:100%; height:88rpx; line-height:44rpx;
  padding:22rpx 24rpx; border:2rpx solid #ebebeb;
  border-radius:18rpx; font-size:28rpx; color:#191919; background:#fafafa;
  box-sizing:border-box; transition:border-color .2s;
}
.field-input:focus { border-color:#07c160; }
.picker-input { color:#9a9a9a; }
.field-textarea {
  min-height:140rpx; line-height:1.6; height:auto;
  white-space:pre-wrap;
}

.form-actions { display:flex; gap:16rpx; margin-top:16rpx; }
.btn-cancel {
  flex:1; padding:26rpx 0; border:2rpx solid #ebebeb; border-radius:18rpx;
  background:transparent; font-size:28rpx; color:#576b95; text-align:center;
  transition:background .15s;
}
.btn-cancel::after { border:none; }
.btn-cancel:active { background:#f3f3f3; }
.btn-primary {
  flex:2; padding:26rpx 0; border:none; border-radius:18rpx;
  background:linear-gradient(135deg,#07c160,#00b89a);
  font-size:28rpx; font-weight:700; color:#fff; text-align:center;
  box-shadow:0 6rpx 20rpx rgba(7,193,96,.3);
  transition:transform .15s, box-shadow .15s;
}
.btn-primary::after { border:none; }
.btn-primary:active { transform:scale(.96); box-shadow:0 2rpx 8rpx rgba(7,193,96,.2); }

/* ══ 照片弹层 ══ */
.photo-sheet { padding-bottom:60rpx; }
.photo-sheet-title { text-align:center; font-size:32rpx; font-weight:700; color:#191919; margin-bottom:8rpx; display:block; }
.photo-sheet-sub { text-align:center; font-size:22rpx; color:#9a9a9a; margin-bottom:36rpx; display:block; }
.photo-btns { display:flex; gap:24rpx; margin-bottom:24rpx; }
.photo-btn {
  flex:1; display:flex; flex-direction:column; align-items:center; gap:14rpx;
  padding:36rpx 20rpx; border:2rpx solid #ebebeb; border-radius:24rpx;
  background:#fafafa; font-size:28rpx; color:#191919;
  transition:border-color .15s, background .15s, transform .15s;
}
.photo-btn-hover { border-color:#07c160; background:#edfbf4; transform:scale(.97); }
.photo-btn-icon { font-size:60rpx; }
.photo-btn-label { font-size:28rpx; color:#191919; }
.btn-skip {
  width:100%; padding:26rpx 0; border:none; background:transparent;
  font-size:28rpx; color:#9a9a9a; text-align:center;
}
.btn-skip::after { border:none; }

/* ══ 邀请弹层 ══ */
.invite-sheet { padding-bottom:80rpx; }
.invite-desc { font-size:26rpx; color:#576b95; text-align:center; line-height:1.7; margin-bottom:36rpx; display:block; }
.invite-code-box {
  background:linear-gradient(135deg,#f0fdf7,#e8f5ff); border-radius:24rpx;
  padding:32rpx; text-align:center; margin-bottom:32rpx;
  border:2rpx dashed #07c160;
}
.invite-code-label { display:block; font-size:22rpx; color:#9a9a9a; margin-bottom:12rpx; }
.invite-code-text { font-size:56rpx; font-weight:900; color:#07c160; letter-spacing:8rpx; }
.invite-actions { display:flex; gap:16rpx; margin-bottom:24rpx; }
.btn-invite-copy {
  flex:1; padding:24rpx 0; border:2rpx solid #07c160; border-radius:18rpx;
  background:transparent; font-size:28rpx; color:#07c160; text-align:center;
}
.btn-invite-copy::after { border:none; }
.btn-invite-share {
  flex:1; padding:24rpx 0; border:none; border-radius:18rpx;
  background:linear-gradient(135deg,#07c160,#00b89a);
  font-size:28rpx; color:#fff; text-align:center;
}
.btn-invite-share::after { border:none; }
.invite-tip { background:#fffbf0; border-radius:16rpx; padding:20rpx 24rpx; margin-bottom:16rpx; }
.invite-tip-text { font-size:22rpx; color:#ff9900; line-height:1.6; }

/* ══ Toast ══ */
.toast {
  position:fixed; bottom:190rpx; left:50%; transform:translateX(-50%) translateY(20rpx);
  background:rgba(0,0,0,.75); color:#fff; padding:18rpx 40rpx;
  border-radius:100rpx; font-size:26rpx; z-index:999;
  opacity:0; pointer-events:none;
  transition:opacity .25s, transform .25s;
  white-space:nowrap;
}
.toast.show { opacity:1; transform:translateX(-50%) translateY(0); }
