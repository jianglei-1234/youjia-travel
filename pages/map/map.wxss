/* pages/map/map.wxss */
.map-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f5e9 0%, #f6f6f6 50%);
  padding-bottom: 40rpx;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 20rpx 24rpx 12rpx;
  padding: 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.04);
}
.stat-item { display: flex; flex-direction: column; align-items: center; flex: 1; }
.stat-num { font-size: 44rpx; font-weight: 700; color: #07c160; line-height: 1.2; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.stat-divider { width: 2rpx; height: 48rpx; background: #eee; }

/* 地图容器 */
.map-wrapper {
  margin: 0 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  height: 680rpx;
  position: relative;
}
.china-map {
  width: 100%;
  height: 100%;
}

/* 图例 */
.map-legend {
  position: absolute;
  bottom: 16rpx; left: 16rpx;
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.92);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.08);
}
.legend-item {
  display: flex;
  align-items: center;
  margin-right: 12rpx;
}
.legend-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #07c160; margin-right: 6rpx; }
.legend-dot.lit { box-shadow: 0 0 6rpx rgba(7,193,96,0.6); }
.legend-item text { font-size: 20rpx; color: #555; }
.legend-btn {
  font-size: 20rpx;
  color: #07c160;
  background: #e8f5e9;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* 空状态 */
.empty-map {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 680rpx;
  background: rgba(240,249,244,0.95);
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #666; font-weight: 500; }
.empty-sub { font-size: 22rpx; color: #aaa; margin-top: 8rpx; }

/* 城市列表 */
.city-section { margin-top: 20rpx; }
.section-header {
  display: flex; align-items: baseline; justify-content: space-between;
  margin: 0 24rpx 12rpx;
}
.section-title { font-size: 30rpx; font-weight: 600; color: #333; }

.city-grid { display: flex; flex-wrap: wrap; margin: 0 24rpx; }
.city-tag {
  display: flex; align-items: center;
  padding: 10rpx 22rpx; margin: 6rpx;
  background: #fff; border-radius: 30rpx;
  font-size: 24rpx; color: #444;
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.03);
  transition: all 0.15s;
}
.city-tag:active { background: #07c160; color: #fff; transform: scale(0.95); }
.city-badge {
  width: 10rpx; height: 10rpx;
  border-radius: 50%; background: #07c160; margin-right: 8rpx;
}

.province-tag {
  padding: 10rpx 22rpx; margin: 6rpx;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  border-radius: 30rpx;
  font-size: 24rpx; color: #2e7d32; font-weight: 500;
}


