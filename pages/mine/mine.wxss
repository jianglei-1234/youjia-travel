/* pages/mine/mine.wxss */
.mine-page {
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 40rpx;
}

/* 头像卡片 */
.profile-card {
  position: relative;
  margin: 0;
  overflow: hidden;
}
.profile-bg {
  height: 220rpx;
  background: linear-gradient(135deg, #07c160 0%, #05d0a0 40%, #00b3a0 100%);
  border-radius: 0 0 40rpx 40rpx;
}
.profile-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -80rpx;
  padding-bottom: 30rpx;
}
.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  border: 6rpx solid #fff;
  border-radius: 50%;
  background: #e0e0e0;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}
/* 【优化 2026-09-25】重置头像按钮的 button 默认样式，保证圆形头像正常显示 */
.avatar-btn::after { border: none; }
/* 【优化 2026-09-25】昵称填写输入框（新版头像昵称填写能力） */
.nickname-input {
  margin-top: 12rpx;
  width: 320rpx;
  height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  background: #f6f6f6;
  border-radius: 100rpx;
}
.avatar-img {
  width: 100%;
  height: 100%;
}
.login-hint {
  font-size: 16rpx;
  color: #07c160;
  margin-top: 8rpx;
}
.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-top: 12rpx;
}

/* 数据面板 */
.data-panel {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}
.data-row {
  display: flex;
}
.data-row.small {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.data-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.data-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}
.data-num.green { color: #07c160; }
.data-num.orange { color: #ff9500; }
.data-num.blue { color: #007aff; }
.data-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}
.data-num-sm {
  font-size: 30rpx;
  font-weight: 600;
  color: #555;
}
.data-label-sm {
  font-size: 18rpx;
  color: #aaa;
}

/* 区块标题 */
.section {
  margin: 0 24rpx 20rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

/* 成就网格 */
.achievement-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.achieve-card {
  width: calc(25% - 9rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: #fff;
  border-radius: 14rpx;
  position: relative;
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.03);
}
.achieve-card.locked {
  opacity: 0.4;
  filter: grayscale(100%);
}
.achieve-icon {
  font-size: 36rpx;
}
.achieve-title {
  font-size: 20rpx;
  color: #333;
  font-weight: 500;
  margin-top: 6rpx;
  text-align: center;
}
.achieve-desc {
  font-size: 16rpx;
  color: #999;
  text-align: center;
  margin-top: 2rpx;
}
.achieve-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

/* 菜单 */
.menu-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.03);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: #f9f9f9;
}
.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.menu-sub {
  font-size: 20rpx;
  color: #bbb;
  margin-right: 10rpx;
}
.menu-arrow {
  font-size: 20rpx;
  color: #ccc;
}

/* 关于 */
.about-panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 10rpx;
  box-shadow: 0 1rpx 8rpx rgba(0,0,0,0.03);
}
.about-line {
  font-size: 24rpx;
  color: #666;
  display: block;
  line-height: 2;
}

/* 危险 */
.danger-section .danger-title {
  color: #ff4444;
}
.danger-item {
  background: #fff;
  border-radius: 16rpx;
}
.danger-text {
  color: #ff4444 !important;
}
.danger-sub {
  color: #ff9999 !important;
}

.bottom-space {
  height: 60rpx;
}


