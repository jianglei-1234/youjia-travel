/**
 * 游佳记 · 全局样式 v2
 * rpx 单位：750rpx = 屏幕宽度
 */

/* ── CSS 变量 ── */
page {
  --primary:      #07c160;
  --primary-dk:   #05a050;
  --primary-lt:   #edfbf4;
  --primary-grd:  linear-gradient(135deg, #07c160, #00b89a);

  --blue:         #10aeff;
  --blue-lt:      #e8f5ff;
  --orange:       #ff9900;
  --orange-lt:    #fff7e6;
  --pink:         #fa739f;
  --pink-lt:      #fff0f5;
  --purple:       #7b5ea7;
  --purple-lt:    #f3eeff;
  --danger:       #fa5151;
  --danger-lt:    #fff1f1;

  --text-1:       #191919;
  --text-2:       #576b95;
  --text-3:       #9a9a9a;
  --bg:           #f6f6f6;
  --card:         #ffffff;
  --border:       #ebebeb;

  min-height: 100vh;
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC',
               'Noto Sans SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text-1);
  -webkit-font-smoothing: antialiased;
}

/* ── 通用工具类 ── */
.ellipsis {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-primary { color: var(--primary); }
.text-gray    { color: var(--text-3); }
.text-bold    { font-weight: 700; }

/* ── 全局卡片样式 ── */
.g-card {
  background: var(--card);
  border-radius: 22rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.07);
  padding: 28rpx;
}

/* ── 全局渐变按钮 ── */
.g-btn-primary {
  display: block;
  padding: 28rpx 0;
  border: none;
  border-radius: 18rpx;
  background: var(--primary-grd);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 6rpx 22rpx rgba(7,193,96,.3);
}
.g-btn-primary::after { border: none; }
.g-btn-primary:active { opacity: .88; }

/* ── 全局动画 ── */
.animate-fadeIn  { animation: fadeIn 0.5s ease; }
.animate-slideUp { animation: slideUp 0.5s ease; }
@keyframes fadeIn  { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideUp { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: translateY(0); } }
